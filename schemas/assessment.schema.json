{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softwareone.example/schemas/assessment-1.0.json",
  "title": "SoftwareOne Security Governance Assessment",
  "type": "object",
  "required": ["metadata", "controls", "findings", "discovery"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["schema_version", "engine_version", "run_id", "execution"],
      "properties": {
        "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "engine_version": {"type": "string"},
        "run_id": {"type": "string"},
        "execution": {"type": "object", "required": ["mode", "tenant_mutation"]}
      }
    },
    "controls": {"type": "array", "items": {"type": "object", "required": ["id", "status", "confidence"]}},
    "findings": {"type": "array", "items": {"type": "object", "required": ["id", "control_id", "title", "severity", "evidence", "recommendation"]}},
    "discovery": {"type": "object"}
  }
}
